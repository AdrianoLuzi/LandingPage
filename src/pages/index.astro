---
// src/pages/index.astro
// Importamos el layout que acabamos de crear
import Layout from '../layouts/Layout.astro'
import '../styles/global.css';
---

<Layout title="Kernel Cynapse | Desarrollo de Software">
	<header class="max-w-5xl mx-auto px-8 py-32 flex flex-col items-center text-center">
		<h1 class="text-5xl md:text-7xl font-bold leading-tight text-kernel-blue">
			Ingeniería de software para <br> 
			<span class="text-kernel-green">desafíos complejos.</span>
		</h1>
		<p class="mt-8 text-lg md:text-xl text-kernel-blue max-w-2xl font-light leading-relaxed">
			Diseñamos y construimos plataformas robustas, escalables y seguras que optimizan los procesos críticos de tu negocio.
		</p>
		
		<div class="mt-12 flex flex-col sm:flex-row gap-4">
			<button class="bg-kernel-blue text-kernel-white font-bold px-8 py-4 rounded-md shadow-md hover:bg-kernel-white hover:text-kernel-dark transition transform hover:-translate-y-0.5">
				Cotizar Proyecto
			</button>
		</div>
	</header>
	
	</Layout>
