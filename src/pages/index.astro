---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import Soluciones from '../components/Soluciones.astro'
import Clientes from '../components/Clientes.astro';
import Formulario from '../components/Formulario.astro';
import Preguntas from '../components/Preguntas.astro';

import Circuito from '../components/Circuito.astro';
import '../styles/global.css';
---

<Layout title="Kernel Cynapse | Desarrollo de Software">
  <main class="relative w-full min-h-[3300px] overflow-hidden">
    
    <!-- === CAPA 1: LA SECUENCIA DE TUS FONDOS EXACTOS === -->
    <div class="absolute top-0 left-0 w-full h-full z-0 flex flex-col pointer-events-none">
        <!-- 1. Fondo del Hero (Oscuro -> Azul) -->
        <div class="min-h-screen bg-linear-to-t from-[#6B8CFF] via-[#0A101D] to-[#0A101D]"></div>
        
        <!-- 2. Fondo de Soluciones (Azul -> Oscuro) -->
        <div class="min-h-screen bg-linear-to-b from-[#6B8CFF] via-[#0A101D] to-[#0A101D]"></div>
        
        <!-- 3. Fondo para el resto de tu página (Clientes, Preguntas, etc.) -->
        <div class="grow bg-[#0A101D]"></div>
    </div>

    <!-- === CAPA 2: EL CIRCUITO GLOBAL === -->
    <div class="absolute top-0 left-0 w-full h-full z-10 pointer-events-none">
        <Circuito />
    </div>

   
    <div class="relative z-20 flex flex-col w-full">
        <Hero />
        <Soluciones />
        <Clientes />
        <Preguntas />
        <Formulario />
        
    </div>

  </main>
</Layout>