---
// src/components/Soluciones.astro
---
<section id="soluciones" class="py-24 bg-kernel-dark text-kernel-blue">
    <div class="max-w-7xl mx-auto px-8">
        
        <header class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold">
                Nuestras <span class="text-kernel-green">Soluciones</span>
            </h2>
            <p class="mt-4 text-kernel-blue">Arquitectura diseñada para escalar.</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            
            <article class="p-8 border border-kernel-green rounded-xl bg-black/20 hover:border-kernel-green transition duration-300 group">
                <div class="w-12 h-12 bg-kernel-green rounded-lg mb-6 group-hover:bg-kernel-greenborder-kernel-green transition"></div>
                <h3 class="text-xl font-bold mb-4">Arquitectura Web</h3>
                <p class="text-gray-400 font-light text-sm">Desarrollo integral de plataformas y APIs robustas.</p>
            </article>

            <article class="p-8 border border-kernel-green rounded-xl bg-black/20 hover:border-kernel-green transition duration-300 group">
                <div class="w-12 h-12 bg-kernel-green rounded-lg mb-6 group-hover:bg-kernel-greenborder-kernel-green transition"></div>
                <h3 class="text-xl font-bold mb-4">Sistemas Nativos</h3>
                <p class="text-gray-400 font-light text-sm">Aplicaciones de escritorio para máximo rendimiento local.</p>
            </article>

            <article class="p-8 border border-kernel-green rounded-xl bg-black/20 hover:border-kernel-green transition duration-300 group">
                <div class="w-12 h-12 bg-kernel-green rounded-lg mb-6 group-hover:bg-kernel-greenborder-kernel-green transition"></div>
                <h3 class="text-xl font-bold mb-4">Quality Assurance</h3>
                <p class="text-gray-400 font-light text-sm">Pipelines de prueba y automatización para entregas seguras.</p>
            </article>
            
        </div>
    </div>
</section>