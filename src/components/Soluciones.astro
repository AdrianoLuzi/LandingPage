<style>
    .circuito-base svg, 
    .circuito-luces svg {
        width: 100%;
        height: 100%;
    }

    /* === 1. PLACA BASE APAGADA (IMPORTANTE)=== */
    .circuito-base path, 
    .circuito-base line {
        stroke: rgba(255, 255, 255, 0.08); 
        stroke-width: 1.5px;    
        fill: none;           
    }
    /* === 1. CIRCULOS (IMPORTANTE)=== */
    .circuito-base circle {
        fill: #172554;        
        stroke: #172554;
        stroke-width: 1px; 
    }

    /* === 2. MÁSCARA DEL PUNTERO (IMPORTANTE) === */
    .circuito-luces {
        -webkit-mask-image: radial-gradient(circle 350px at var(--mouse-x, -500px) var(--mouse-y, -500px), rgba(0,0,0,1) 10%, rgba(0,0,0,0) 100%);
        mask-image: radial-gradient(circle 350px at var(--mouse-x, -500px) var(--mouse-y, -500px), rgba(0,0,0,1) 10%, rgba(0,0,0,0) 100%);
        
        /* 'screen' evita que los círculos agrandados sufran el glitch de desaparición */
        mix-blend-mode: screen; 
        transition: opacity 0.5s ease;
    }

    /* === 3. LAS LÍNEAS DE LUZ (IMPORTANTE) === */
    .circuito-luces path, 
    .circuito-luces line,
    .circuito-luces circle {
        stroke: #556496 !important; /* Color base intenso */
        stroke-width: 1.5px !important; /* TAMAÑO DE LINEAS AL ILUMINAR*/
        fill: none !important;
        stroke-linecap: round !important;
        stroke-dasharray: none !important;
        stroke-dashoffset: 0 !important;
        animation: latidoNeon 3s ease-in-out infinite alternate !important;
    }

    /* === DEFINICIÓN DE LA ANIMACIÓN SOLICITADA === */
    @keyframes latidoNeon {
        0% {
            opacity: 0.8;
        }
        100% {
            opacity: 1;
        }
    }
</style>

<script>
    const solucionesSection = document.getElementById('soluciones');
    const capaLuces = document.querySelector('#soluciones .circuito-luces') as HTMLElement;

    if (solucionesSection && capaLuces) {
        document.addEventListener('mousemove', (e) => {
            const rect = solucionesSection.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            capaLuces.style.opacity = '1';
            capaLuces.style.setProperty('--mouse-x', `${x}px`);
            capaLuces.style.setProperty('--mouse-y', `${y}px`);
        });

        document.addEventListener('mouseleave', () => {
            capaLuces.style.opacity = '0';
        });
    }
</script>