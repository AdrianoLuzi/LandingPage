<style>
    .circuito-base svg, 
    .circuito-luces svg {
        width: 100%;
        height: 100%;
    }

    /* === 1. PLACA BASE APAGADA === */
    .circuito-base path, 
    .circuito-base line {
        stroke: rgba(255, 255, 255, 0.08) !important; 
        stroke-width: 1.5px !important;    
        fill: none !important;            
    }
    
    .circuito-base circle {
        fill: #172554 !important;        
        stroke: #172554 !important;
        stroke-width: 0.5px !important; 
    }

    /* === 2. MÁSCARA ULTRA LIGERA === */
    .circuito-luces {
        /* Creamos un degradado fijo, SIN mix-blend-mode */
        -webkit-mask-image: radial-gradient(circle, rgba(0,0,0,1) 10%, rgba(0,0,0,0) 65%);
        mask-image: radial-gradient(circle, rgba(0,0,0,1) 10%, rgba(0,0,0,0) 65%);
        
        /* MAGIA: Anclamos el tamaño a 600px para que no calcule los 3300px */
        -webkit-mask-size: 600px 600px;
        mask-size: 600px 600px;
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        
        /* Deslizamos ese cuadrado de 600px siguiendo el mouse */
        -webkit-mask-position: calc(var(--mouse-x) - 300px) calc(var(--mouse-y) - 300px);
        mask-position: calc(var(--mouse-x) - 300px) calc(var(--mouse-y) - 300px);
        
        transition: opacity 0.3s ease;
        will-change: mask-position, opacity;
        transform: translateZ(0); 
        backface-visibility: hidden;

        /* Latido aplicado a TODA la capa junta */
        animation: latidoNeon 3s ease-in-out infinite alternate !important;
    }

    /* === 3. LAS LÍNEAS DE LUZ (Sin animaciones individuales) === */
    .circuito-luces path, 
    .circuito-luces line,
    .circuito-luces circle {
        stroke: #172554 !important; 
        stroke-width: 1.5px !important; 
        fill: none !important;
        stroke-linecap: round !important;
    }

    .circuito-luces circle {
        fill: #172554 !important;
    }

    @keyframes latidoNeon {
        0% { opacity: 0.6; }
        100% { opacity: 1; }
    }
</style>

<script>
    const capaLuces = document.querySelector('.circuito-luces') as HTMLElement;

    if (capaLuces) {
        const esDispositivoTactil = window.matchMedia('(hover: none), (pointer: coarse)').matches;

        if (esDispositivoTactil) {
            // === MODO CELULAR ===
            const pulsoDeEnergia = () => {
                const scrollActual = window.scrollY;
                const altoPantalla = window.innerHeight;
                const randomX = Math.floor(Math.random() * window.innerWidth);
                const randomY = Math.floor(scrollActual + (Math.random() * altoPantalla));

                capaLuces.style.setProperty('--mouse-x', `${randomX}px`);
                capaLuces.style.setProperty('--mouse-y', `${randomY}px`);
                capaLuces.style.opacity = '1';

                setTimeout(() => { capaLuces.style.opacity = '0'; }, 1200);
            };
            setTimeout(pulsoDeEnergia, 300);
            setInterval(pulsoDeEnergia, 2000);

        } else {
            // === MODO PC ===
            let ticking = false;
            let isScrolling: ReturnType<typeof setTimeout> | undefined;

            // 1. Apagamos la luz instantáneamente al hacer scroll (Cero Tirones)
            window.addEventListener('scroll', () => {
                capaLuces.style.opacity = '0';
                
                window.clearTimeout(isScrolling);
                
                // La encendemos de nuevo 150ms después de que el usuario deja de scrollear
                isScrolling = setTimeout(() => {
                    capaLuces.style.opacity = '1';
                }, 150);
            }, { passive: true });

            // 2. Movimiento súper optimizado
            document.addEventListener('mousemove', (e) => {
                // Solo calculamos si la luz está encendida (no está scrolleando)
                if (capaLuces.style.opacity !== '0' && !ticking) {
                    window.requestAnimationFrame(() => {
                        capaLuces.style.setProperty('--mouse-x', `${e.pageX}px`);
                        capaLuces.style.setProperty('--mouse-y', `${e.pageY}px`);
                        ticking = false;
                    });
                    ticking = true;
                }
            });

            document.addEventListener('mouseleave', () => {
                capaLuces.style.opacity = '0';
            });
        }
    }
</script>