---
// src/pages/planes.astro
import Layout from '../layouts/Layout.astro';
import '../styles/global.css'; 
---

<Layout title="Elegí tu Plan | Kernel Cynapse">
    <main class="min-h-screen bg-[#0A101D] flex flex-col items-center pt-32 md:pt-35 pb-20 px-4 sm:px-6 font-sans text-[#FFFFFF]">
        
        <!-- Contenedor Principal -->
        <div class="w-full max-w-[1000px] bg-[#222121] rounded-[2rem] p-5 md:p-8 shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-[#4E6D93]/20">
            
            <!-- Encabezado del Tablero -->
            <div class="flex justify-between items-center mb-8 px-2 md:px-4">
                <div class="flex items-center">
                    <div class="px-3 py-1 border-2 border-[#FFFFFF]/80 rounded-lg text-[#FFFFFF] font-black tracking-widest text-xs uppercase shadow-[0_0_10px_rgba(255,255,255,0.1)]">
                        LOGO
                    </div>
                </div>
                
                <h1 class="text-xl md:text-3xl font-bold tracking-wide text-[#FFFFFF]">Elegí tu mejor plan</h1>
                
                <div class="flex items-center justify-center cursor-pointer hover:scale-105 transition-transform">
                    <span class="text-[#C8DDA4] font-black text-xl tracking-widest drop-shadow-[0_0_8px_rgba(200,221,164,0.3)]">KC</span>
                </div>
            </div>

            <!-- GRILLA DE PLANES -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 md:gap-6 mb-8">
                
                <!-- TARJETA 1: Inicial -->
                <label class="relative block cursor-pointer group/card h-[460px]">
                    <input type="radio" name="plan_base" value="Plan Inicial" data-precio="75" class="peer sr-only" checked>
                    
                    <div class="absolute inset-0 rounded-[1.8rem] bg-gradient-to-br from-[#2a3a4e] to-[#3b5270] p-8 overflow-hidden transition-all duration-300 peer-checked:ring-4 peer-checked:ring-[#C8DDA4]/60 peer-checked:-translate-y-2 group-hover/card:-translate-y-2 group-has-[.btn-zone:hover]/card:!translate-y-0">
                        <div class="absolute -top-10 -right-10 w-40 h-40 bg-[#FFFFFF]/5 rounded-full blur-2xl"></div>

                        <h2 class="text-2xl font-bold text-center mb-2 relative z-10 text-[#FFFFFF]">Plan Inicial</h2>
                        <p class="text-center text-[12px] text-[#FFFFFF]/60 mb-8 relative z-10">Ideal para dar los primeros pasos.</p>

                        <ul class="space-y-4 text-[14px] text-[#FFFFFF]/90 relative z-10">
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-[#C8DDA4]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Usuarios limitados</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-[#C8DDA4]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Control de stock</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-[#C8DDA4]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Gestión de clientes</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-[#C8DDA4]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Módulo de ventas</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-[#C8DDA4]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Soporte por ticket</li>
                        </ul>

                        <div class="absolute bottom-8 left-8">
                            <span class="text-4xl font-black block mb-0.5 text-[#FFFFFF]">$75 <span class="text-lg font-bold text-[#FFFFFF]/70">ARS</span></span>
                            <span class="text-[11px] text-[#FFFFFF]/70 uppercase tracking-widest font-medium">por mes</span>
                        </div>
                    </div>

                    <div class="btn-zone absolute bottom-0 right-0 w-[120px] h-[60px] bg-[#222121] rounded-tl-[1.4rem] p-1.5 pb-0 pr-0 z-20 group-has-[:checked]/card:pointer-events-none">
                        <div class="group/btn relative w-full h-full">
                            <div class="absolute inset-0 bg-[#151515] rounded-tl-[1rem] rounded-br-[1.4rem] transition-transform duration-300 group-hover/btn:translate-y-[2px]"></div>
                            <div class="absolute inset-0 bg-[#2a2929] rounded-tl-[1rem] rounded-br-[1.4rem] flex items-center justify-center gap-1.5 text-[12px] font-bold transition-transform duration-300 group-hover/btn:-translate-y-[2px] group-has-[:checked]/card:bg-[#C8DDA4] group-has-[:checked]/card:text-[#222121] text-[#FFFFFF]/70">
                                <span class="block group-has-[:checked]/card:hidden">Elegir</span>
                                <span class="hidden group-has-[:checked]/card:block">Elegido</span>
                                <svg class="w-3.5 h-3.5 text-[#C8DDA4] group-has-[:checked]/card:text-[#222121]" fill="currentColor" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </div>
                        </div>
                    </div>
                </label>

                <!-- TARJETA 2: Medio -->
                <label class="relative block cursor-pointer group/card h-[460px]">
                    <input type="radio" name="plan_base" value="Plan Medio" data-precio="150" class="peer sr-only">
                    
                    <div class="absolute inset-0 rounded-[1.8rem] bg-gradient-to-br from-[#5b7a9e] to-[#4E6D93] p-8 overflow-hidden transition-all duration-300 peer-checked:ring-4 peer-checked:ring-[#C8DDA4]/60 peer-checked:-translate-y-2 group-hover/card:-translate-y-2 group-has-[.btn-zone:hover]/card:!translate-y-0">
                        <div class="absolute -top-10 -right-10 w-40 h-40 bg-[#FFFFFF]/10 rounded-full blur-2xl"></div>

                        <h2 class="text-2xl font-bold text-center mb-2 relative z-10 text-[#FFFFFF]">Plan Medio</h2>
                        <p class="text-center text-[12px] text-[#FFFFFF]/60 mb-8 relative z-10">Para negocios en expansión.</p>

                        <ul class="space-y-4 text-[14px] text-[#FFFFFF]/90 relative z-10">
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-[#C8DDA4]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Usuarios ilimitados</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-[#C8DDA4]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Reportes avanzados</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-[#C8DDA4]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Backups diarios</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-[#C8DDA4]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Soporte prioritario</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-[#C8DDA4]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Todo lo del Inicial</li>
                        </ul>

                        <div class="absolute bottom-8 left-8">
                            <span class="text-4xl font-black block mb-0.5 text-[#FFFFFF]">$150 <span class="text-lg font-bold text-[#FFFFFF]/70">ARS</span></span>
                            <span class="text-[11px] text-[#FFFFFF]/70 uppercase tracking-widest font-medium">por mes</span>
                        </div>
                    </div>

                    <div class="btn-zone absolute bottom-0 right-0 w-[120px] h-[60px] bg-[#222121] rounded-tl-[1.4rem] p-1.5 pb-0 pr-0 z-20 group-has-[:checked]/card:pointer-events-none">
                        <div class="group/btn relative w-full h-full">
                            <div class="absolute inset-0 bg-[#151515] rounded-tl-[1rem] rounded-br-[1.4rem] transition-transform duration-300 group-hover/btn:translate-y-[2px]"></div>
                            <div class="absolute inset-0 bg-[#2a2929] rounded-tl-[1rem] rounded-br-[1.4rem] flex items-center justify-center gap-1.5 text-[12px] font-bold transition-transform duration-300 group-hover/btn:-translate-y-[2px] group-has-[:checked]/card:bg-[#C8DDA4] group-has-[:checked]/card:text-[#222121] text-[#FFFFFF]/70">
                                <span class="block group-has-[:checked]/card:hidden">Elegir</span>
                                <span class="hidden group-has-[:checked]/card:block">Elegido</span>
                                <svg class="w-3.5 h-3.5 text-[#C8DDA4] group-has-[:checked]/card:text-[#222121]" fill="currentColor" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </div>
                        </div>
                    </div>
                </label>

                <!-- TARJETA 3: Grande -->
                <label class="relative block cursor-pointer group/card h-[460px]">
                    <input type="radio" name="plan_base" value="Plan Grande" data-precio="225" class="peer sr-only">
                    
                    <div class="absolute inset-0 rounded-[1.8rem] bg-gradient-to-br from-[#e0f0cd] to-[#C8DDA4] p-8 overflow-hidden transition-all duration-300 peer-checked:ring-4 peer-checked:ring-[#4E6D93]/60 peer-checked:-translate-y-2 group-hover/card:-translate-y-2 group-has-[.btn-zone:hover]/card:!translate-y-0">
                        <div class="absolute -top-10 -right-10 w-40 h-40 bg-[#FFFFFF]/30 rounded-full blur-2xl"></div>

                        <h2 class="text-2xl font-bold text-center mb-2 relative z-10 text-[#222121]">Plan Grande</h2>
                        <p class="text-center text-[12px] text-[#222121]/60 mb-8 relative z-10 font-bold">La solución corporativa total.</p>

                        <ul class="space-y-4 text-[14px] text-[#222121]/90 relative z-10 font-medium">
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-[#4E6D93]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Multisuperficie</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-[#4E6D93]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Servidor dedicado</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-[#4E6D93]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Funciones a medida</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-[#4E6D93]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Soporte 24/7</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-[#4E6D93]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Todo lo del Medio</li>
                        </ul>

                        <div class="absolute bottom-8 left-8">
                            <span class="text-4xl font-black block mb-0.5 text-[#222121]">$225 <span class="text-lg font-bold text-[#222121]/70">ARS</span></span>
                            <span class="text-[11px] text-[#222121]/70 uppercase tracking-widest font-bold">por mes</span>
                        </div>
                    </div>

                    <div class="btn-zone absolute bottom-0 right-0 w-[120px] h-[60px] bg-[#222121] rounded-tl-[1.4rem] p-1.5 pb-0 pr-0 z-20 group-has-[:checked]/card:pointer-events-none">
                        <div class="group/btn relative w-full h-full">
                            <div class="absolute inset-0 bg-[#151515] rounded-tl-[1rem] rounded-br-[1.4rem] transition-transform duration-300 group-hover/btn:translate-y-[2px]"></div>
                            <div class="absolute inset-0 bg-[#2a2929] rounded-tl-[1rem] rounded-br-[1.4rem] flex items-center justify-center gap-1.5 text-[12px] font-bold transition-transform duration-300 group-hover/btn:-translate-y-[2px] group-has-[:checked]/card:bg-[#4E6D93] group-has-[:checked]/card:text-[#FFFFFF] text-[#FFFFFF]/70">
                                <span class="block group-has-[:checked]/card:hidden">Elegir</span>
                                <span class="hidden group-has-[:checked]/card:block">Elegido</span>
                                <svg class="w-3.5 h-3.5 text-[#4E6D93] group-has-[:checked]/card:text-[#FFFFFF]" fill="currentColor" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </div>
                        </div>
                    </div>
                </label>
            </div>

            <!-- BARRA INFERIOR DE CONTACTO -->
            <div class="bg-[#151515] rounded-2xl p-6 border border-[#4E6D93]/30 flex flex-col md:flex-row items-center justify-between gap-6 shadow-lg">
                <div class="text-center md:text-left w-full md:w-auto">
                    <span class="text-[#FFFFFF]/50 text-[11px] font-bold uppercase tracking-wider block mb-1">Has seleccionado:</span>
                    <div id="plan-display" class="text-xl md:text-2xl font-bold text-[#C8DDA4]">Plan Inicial ($75 ARS/mes)</div>
                </div>
                
                <!-- BOTÓN CORREGIDO: Mismo color, solo se levanta -->
                <a id="btn-contactar" href="#" target="_blank" class="w-full md:w-auto px-10 py-4 bg-[#C8DDA4] text-[#222121] font-bold rounded-xl transition-all duration-300 hover:-translate-y-1 shadow-[0_0_20px_rgba(200,221,164,0.15)] whitespace-nowrap text-center">
                    Contactar Asesor
                </a>
            </div>

            <!-- Footer interno -->
            <div class="flex justify-between items-center mt-8 px-2 text-[11px] text-[#FFFFFF]/40">
                <span>© 2026 Kernel Cynapse.</span>
                <a href="/cotizar" class="hover:text-[#FFFFFF] transition-colors">Volver a Modelos</a>
            </div>

        </div>
    </main>
</Layout>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const radios = document.querySelectorAll<HTMLInputElement>('input[name="plan_base"]');
        const planDisplay = document.getElementById('plan-display')!;
        const btnContactar = document.getElementById('btn-contactar') as HTMLAnchorElement;

        // TU CORREO ACÁ: Cambiá esto por el mail de la agencia
        const emailDestino = "contacto@kernelcynapse.com"; 

        const actualizarPanel = () => {
            const planElegido = document.querySelector<HTMLInputElement>('input[name="plan_base"]:checked');
            
            if (planElegido) {
                const nombrePlan = planElegido.value;
                const precioPlan = planElegido.dataset.precio; 
                
                // Actualiza el texto visual de abajo
                planDisplay.textContent = `${nombrePlan} ($${precioPlan} ARS/mes)`;

                // Arma el contenido del correo
                const subject = `Consulta de Suscripción: ${nombrePlan}`;
                const body = `Hola equipo de Kernel Cynapse,%0D%0A%0D%0AEstoy interesado en contratar el ${nombrePlan} por un valor de $${precioPlan} ARS mensuales.%0D%0A%0D%0AMe gustaría que se contacten conmigo para avanzar con los detalles.%0D%0A%0D%0AGracias.`;

                // Aplica el mailto al botón
                btnContactar.href = `mailto:${emailDestino}?subject=${subject}&body=${body}`;
            }
        };

        // Escucha cambios en las tarjetas
        radios.forEach(radio => radio.addEventListener('change', actualizarPanel));
        
        // Ejecuta al cargar la página
        actualizarPanel();
    });
</script>