---
// src/pages/planes.astro

import '../styles/global.css'; 
---

<section>
    <main class="min-h-screen bg-kernel-bgblue flex flex-col items-center pt-32 md:pt-35 pb-20 px-4 sm:px-6 font-sans text-kernel-white z-20">
        
        <!-- Contenedor Principal -->
        <div class="w-full max-w-250 bg-kernel-dark rounded-4x1 p-5 md:p-8 shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-kernel-blue/20">
            
            <!-- Encabezado del Tablero -->
            <div class="flex justify-between items-center mb-8 px-2 md:px-4">
                
                
                <h1 class="text-xl md:text-3xl font-bold tracking-wide text-kernel-white">Elegí tu mejor plan</h1>
                
                <a href="/Suscripcion" class="flex items-center justify-center cursor-pointer hover:scale-105 transition-transform px-3 py-1 border-2 text-kernel-white border-kernel-white/80 rounded-lg hover:text-kernel-green hover:border-kernel-green font-black tracking-widest text-[11px] uppercase shadow-[0_0_10px_rgba(255,255,255,0.1)] mb-2 mt-2">
                    ← Atrás
                </a>
            </div>

            <!-- GRILLA DE PLANES -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 md:gap-6 mb-8">
                
                <!-- TARJETA 1: Inicial -->
                <label class="relative block cursor-pointer group/card h-115">
                    <input type="radio" name="plan_base" value="Plan Inicial" data-precio="75" class="peer sr-only" checked>
                    
                    <div class="absolute inset-0 rounded-[1.8rem] bg-linear-to-br from-[#2a3a4e] to-[#3b5270] p-8 overflow-hidden transition-all duration-300 peer-checked:ring-4 peer-checked:ring-kernel-green/60 peer-checked:-translate-y-2 group-hover/card:-translate-y-2 group-has-[.btn-zone:hover]/card:translate-y-0">
                        <div class="absolute -top-10 -right-10 w-40 h-40 bg-kernel-white/5 rounded-full blur-2xl"></div>

                        <h2 class="text-2xl font-bold text-center mb-2 relative z-10 text-kernel-white">Plan Inicial</h2>
                        <p class="text-center text-[12px] text-kernel-white/60 mb-8 relative z-10">Ideal para dar los primeros pasos.</p>

                        <ul class="space-y-4 text-[14px] text-kernel-white/90 relative z-10">
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-kernel-green" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Usuarios limitados</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-kernel-green" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Control de stock</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-kernel-green" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Gestión de clientes</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-kernel-green" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Módulo de ventas</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-kernel-green" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Soporte por ticket</li>
                        </ul>

                        <div class="absolute bottom-8 left-8">
                            <span class="text-4xl font-black block mb-0.5 text-kernel-white">$75.000 <span class="text-lg font-bold text-kernel-white/70">ARS</span></span>
                            <span class="text-[11px] text-kernel-white/70 uppercase tracking-widest font-medium">por mes</span>
                        </div>
                    </div>

                    <div class="btn-zone absolute bottom-0 right-0 w-30 h-15 bg-kernel-dark rounded-tl-[1.4rem] p-1.5 pb-0 pr-0 z-20 group-has-:checked/card:pointer-events-none">
                        <div class="group/btn relative w-full h-full">
                            <div class="absolute inset-0 bg-[#151515] rounded-tl-2x1 rounded-br-[1.4rem] transition-transform duration-300 group-hover/btn:translate-y-0.5"></div>
                            <div class="absolute inset-0 bg-[#2a2929] rounded-tl-2x1 rounded-br-[1.4rem] flex items-center justify-center gap-1.5 text-[12px] font-bold transition-transform duration-300 group-hover/btn:-translate-y-0.5 group-has-:checked/card:bg-kernel-green group-has-:checked/card:text-kernel-dark text-kernel-white/70">
                                <span class="block group-has-:checked/card:hidden">Elegir</span>
                                <span class="hidden group-has-:checked/card:block">Elegido</span>
                                <svg class="w-3.5 h-3.5 text-kernel-green group-has-:checked/card:text-kernel-dark" fill="currentColor" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </div>
                        </div>
                    </div>
                </label>

                <!-- TARJETA 2: Medio -->
                <label class="relative block cursor-pointer group/card h-115">
                    <input type="radio" name="plan_base" value="Plan Medio" data-precio="150" class="peer sr-only">
                    
                    <div class="absolute inset-0 rounded-[1.8rem] bg-linear-to-br from-[#5b7a9e] to-kernel-blue p-8 overflow-hidden transition-all duration-300 peer-checked:ring-4 peer-checked:ring-kernel-green/60 peer-checked:-translate-y-2 group-hover/card:-translate-y-2 group-has-[.btn-zone:hover]/card:translate-y-0">
                        <div class="absolute -top-10 -right-10 w-40 h-40 bg-kernel-white/10 rounded-full blur-2xl"></div>

                        <h2 class="text-2xl font-bold text-center mb-2 relative z-10 text-kernel-white">Plan Medio</h2>
                        <p class="text-center text-[12px] text-kernel-white/60 mb-8 relative z-10">Para negocios en expansión.</p>

                        <ul class="space-y-4 text-[14px] text-kernel-white/90 relative z-10">
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-kernel-green" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Usuarios ilimitados</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-kernel-green" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Reportes avanzados</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-kernel-green" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Backups diarios</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-kernel-green" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Soporte prioritario</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-kernel-green" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Todo lo del Inicial</li>
                        </ul>

                        <div class="absolute bottom-8 left-8">
                            <span class="text-4xl font-black block mb-0.5 text-kernel-white">$150.000 <span class="text-lg font-bold text-kernel-white/70">ARS</span></span>
                            <span class="text-[11px] text-kernel-white/70 uppercase tracking-widest font-medium">por mes</span>
                        </div>
                    </div>

                    <div class="btn-zone absolute bottom-0 right-0 w-30 h-15 bg-kernel-dark rounded-tl-[1.4rem] p-1.5 pb-0 pr-0 z-20 group-has-:checked/card:pointer-events-none">
                        <div class="group/btn relative w-full h-full">
                            <div class="absolute inset-0 bg-[#151515] rounded-tl-2x1 rounded-br-[1.4rem] transition-transform duration-300 group-hover/btn:translate-y-0.5"></div>
                            <div class="absolute inset-0 bg-[#2a2929] rounded-tl-2x1 rounded-br-[1.4rem] flex items-center justify-center gap-1.5 text-[12px] font-bold transition-transform duration-300 group-hover/btn:-translate-y-0.5 group-has-:checked/card:bg-kernel-green group-has-:checked/card:text-kernel-dark text-kernel-white/70">
                                <span class="block group-has-:checked/card:hidden">Elegir</span>
                                <span class="hidden group-has-:checked/card:block">Elegido</span>
                                <svg class="w-3.5 h-3.5 text-kernel-green group-has-:checked/card:text-kernel-dark" fill="currentColor" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </div>
                        </div>
                    </div>
                </label>

                <!-- TARJETA 3: Grande -->
                <label class="relative block cursor-pointer group/card h-115">
                    <input type="radio" name="plan_base" value="Plan Grande" data-precio="225" class="peer sr-only">
                    
                    <div class="absolute inset-0 rounded-[1.8rem] bg-linear-to-br from-[#e0f0cd] to-kernel-green p-8 overflow-hidden transition-all duration-300 peer-checked:ring-4 peer-checked:ring-kernel-blue/60 peer-checked:-translate-y-2 group-hover/card:-translate-y-2 group-has-[.btn-zone:hover]/card:translate-y-0">
                        <div class="absolute -top-10 -right-10 w-40 h-40 bg-kernel-white/30 rounded-full blur-2xl"></div>

                        <h2 class="text-2xl font-bold text-center mb-2 relative z-10 text-kernel-dark">Plan Grande</h2>
                        <p class="text-center text-[12px] text-kernel-dark/60 mb-8 relative z-10 font-bold">La solución corporativa total.</p>

                        <ul class="space-y-4 text-[14px] text-kernel-dark/90 relative z-10 font-medium">
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-kernel-blue" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Multiplataforma</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-kernel-blue" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Servidor dedicado</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-kernel-blue" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Funciones a medida</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-kernel-blue" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Soporte 24/7</li>
                            <li class="flex items-center"><svg class="w-4 h-4 mr-3 text-kernel-blue" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg> Todo lo del Medio</li>
                        </ul>

                        <div class="absolute bottom-8 left-8">
                            <span class="text-4xl font-black block mb-0.5 text-kernel-dark">$225.000 <span class="text-lg font-bold text-kernel-dark/70">ARS</span></span>
                            <span class="text-[11px] text-kernel-dark/70 uppercase tracking-widest font-bold">por mes</span>
                        </div>
                    </div>

                    <div class="btn-zone absolute bottom-0 right-0 w-30 h-15 bg-kernel-dark rounded-tl-[1.4rem] p-1.5 pb-0 pr-0 z-20 group-has-:checked/card:pointer-events-none">
                        <div class="group/btn relative w-full h-full">
                            <div class="absolute inset-0 bg-[#151515] rounded-tl-2x1 rounded-br-[1.4rem] transition-transform duration-300 group-hover/btn:translate-y-0.5"></div>
                            <div class="absolute inset-0 bg-[#2a2929] rounded-tl-2x1 rounded-br-[1.4rem] flex items-center justify-center gap-1.5 text-[12px] font-bold transition-transform duration-300 group-hover/btn:-translate-y-0.5 group-has-:checked/card:bg-kernel-blue group-has-:checked/card:text-kernel-white text-kernel-white/70">
                                <span class="block group-has-:checked/card:hidden">Elegir</span>
                                <span class="hidden group-has-:checked/card:block">Elegido</span>
                                <svg class="w-3.5 h-3.5 text-kernel-blue group-has-:checked/card:text-kernel-white" fill="currentColor" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </div>
                        </div>
                    </div>
                </label>
            </div>

            <!-- BARRA INFERIOR DE CONTACTO -->
            <div class="bg-[#151515] rounded-2xl p-6 border border-kernel-blue/30 flex flex-col md:flex-row items-center justify-between gap-6 shadow-lg relative">
                <div class="text-center md:text-left w-full md:w-auto">
                    <span class="text-kernel-white/50 text-[11px] font-bold uppercase tracking-wider block mb-1">Has seleccionado:</span>
                    <div id="plan-display" class="text-xl md:text-2xl font-bold text-kernel-green">Plan Inicial ($75.000 ARS/mes)</div>
                </div>
                
                <button id="btn-contactar" type="button" class="w-full md:w-auto px-10 py-4 bg-kernel-green text-kernel-dark font-bold rounded-xl transition-all duration-300 hover:-translate-y-1 shadow-[0_0_20px_rgba(200,221,164,0.15)] whitespace-nowrap text-center cursor-pointer">
                    Enviar Solicitud
                </button>
            </div>

            <!-- Mensaje de éxito oculto -->
            <div id="mensaje-exito" class="hidden flex-col items-center justify-center text-center p-4 bg-[#2a2929] border border-kernel-green/40 rounded-xl mt-4">
                <div class="w-10 h-10 bg-kernel-green/20 text-kernel-green rounded-full flex items-center justify-center mb-2 text-xl font-bold">✓</div>
                <h3 class="text-sm font-bold text-kernel-white">¡Recibimos tu solicitud!</h3>
                <p class="text-[10px] text-kernel-white/60 mt-1">Un asesor se comunicará contigo pronto.</p>
            </div>

            <!-- Footer interno -->
            <div class="flex justify-between items-center mt-8 px-2 text-[11px] text-kernel-white/40">
                <span>© 2026 Kernel Cynapse.</span>
            </div>

        </div>
    </main>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const radios = document.querySelectorAll<HTMLInputElement>('input[name="plan_base"]');
        const planDisplay = document.getElementById('plan-display')!;
        const btnContactar = document.getElementById('btn-contactar') as HTMLButtonElement;
        const mensajeExito = document.getElementById('mensaje-exito');

        // Actualiza el texto inferior al cambiar de tarjeta
        const actualizarPanel = () => {
            const planElegido = document.querySelector<HTMLInputElement>('input[name="plan_base"]:checked');
            if (planElegido) {
                const nombrePlan = planElegido.value;
                const precioPlan = planElegido.dataset.precio; 
                planDisplay.textContent = `${nombrePlan} ($${precioPlan} ARS/mes)`;
            }
        };

        radios.forEach(radio => radio.addEventListener('change', actualizarPanel));
        actualizarPanel();

        // Lógica de envío a Web3Forms unificando los datos
        if (btnContactar) {
            btnContactar.addEventListener('click', async () => {
                
                // 1. Verificamos si llenó el formulario principal
                const datosGuardados = sessionStorage.getItem('datosLeadKernel');
                if (!datosGuardados) {
                    alert("Por favor, completá tus datos de contacto primero.");
                    window.location.href = '/#contacto'; // Lo devolvemos al inicio
                    return;
                }

                const datosContacto = JSON.parse(datosGuardados);
                const planElegido = document.querySelector<HTMLInputElement>('input[name="plan_base"]:checked');
                
                // 2. Armamos el paquete con los datos de contacto + el plan
                const payload = {
                    access_key: "3ad71605-4007-4974-99e7-b68d387811ed", // ¡NO OLVIDES PONER TU CLAVE ACÁ!
                    subject: "Nueva Solicitud de Suscripción - Kernel Cynapse",
                    ...datosContacto,
                    "Modelo de Negocio": "Suscripción Mensual",
                    "Plan Seleccionado": planElegido ? planElegido.value : "Ninguno",
                    "Precio Mensual": planElegido ? `$${planElegido.dataset.precio} ARS` : "$0 ARS"
                };

                const originalText = btnContactar.textContent;
                btnContactar.textContent = 'Enviando...';
                btnContactar.setAttribute('disabled', 'true');

                // 3. Enviamos
                try {
                    const response = await fetch('https://api.web3forms.com/submit', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (response.status === 200) {
                        btnContactar.style.display = 'none';
                        if (mensajeExito) {
                            mensajeExito.classList.remove('hidden');
                            mensajeExito.classList.add('flex');
                        }
                        sessionStorage.removeItem('datosLeadKernel'); // Limpiamos la memoria
                    } else {
                        alert("Hubo un error al enviar. Intentá nuevamente.");
                        btnContactar.textContent = originalText;
                        btnContactar.removeAttribute('disabled');
                    }
                } catch (error) {
                    alert("Error de red. Verificá tu conexión.");
                    btnContactar.textContent = originalText;
                    btnContactar.removeAttribute('disabled');
                }
            });
        }
    });
</script>