---
// src/components/Footer.astro
import logoSVG from '../assets/LOGOTIPO SERGIO V4(FINAL) copy.svg?raw';
import { Icon } from 'astro-icon/components';
---
<section class="grid grid-cols-2 2xl:grid-cols-3 bg-black z-50 top-0 inset-x-0 items-center py-6 px-6 md:px-12 lg:px-24 transition-all duration-300">
    
    
    <a href="/" class="flex items-center gap-3 justify-self-start">
        <div class="w-16 h-16 text-kernel-green flex items-center justify-center" set:html={logoSVG} />
        
    </a>

    <!-- Columna 2: Menú (Centrado absoluto) -->
    <ul class="hidden 2xl:flex gap-8 text-sm font-semibold text-kernel-green justify-self-center">
        <li><a href="/#soluciones" class="hover:text-white transition duration-300">Por qué elegirnos</a></li>
        <li><a href="/#clientes" class="hover:text-white transition duration-300">Nuestros Clientes</a></li>
        <li><a href="/#faq" class="hover:text-white transition duration-300">FAQ</a></li>
        <li><a href="/#contacto" class="hover:text-white transition duration-300">Contacto</a></li>
    </ul>

    <div class="hidden 2xl:flex gap-8 text-sm font-semibold text-kernel-green justify-self-end">
        
        <a href="https://wa.me/542644176465" target="_blank" rel="noopener noreferrer" 
           class="text-kernel-green hover:text-[#25D366] hover:drop-shadow-[0_0_8px_rgba(37,211,102,0.8)] transition-all duration-300 hover:scale-110">
            <Icon name="mdi:whatsapp" class="w-5 h-5" />
        </a>
        <div class="w-px h-5 bg-[#476A8A]/50"></div>
        <a href="https://www.instagram.com/kernel_cynapse/" target="_blank" rel="noopener noreferrer" 
           class="text-kernel-green hover:text-[#E1306C] hover:drop-shadow-[0_0_8px_rgba(225,48,108,0.8)] transition-all duration-300 hover:scale-110">
            <Icon name="mdi:instagram" class="w-5 h-5" />
        </a>
        <div class="w-px h-5 bg-[#476A8A]/50"></div>
        <a href="mailto:info@kernelcynapse.dev" 
           class="text-kernel-green hover:text-[#EA4335] hover:drop-shadow-[0_0_8px_rgba(234,67,53,0.8)] transition-all duration-300 hover:scale-110">
            <Icon name="mdi:email" class="w-5 h-5" />
        </a>
        <div class="w-px h-5 bg-[#476A8A]/50"></div>
        <a href="https://www.linkedin.com/company/kernel-cynapse/" 
           class="text-kernel-green hover:text-[#0A66C2] hover:drop-shadow-[0_0_8px_rgba(234,67,53,0.8)] transition-all duration-300 hover:scale-110">
            <Icon name="mdi:linkedin" class="w-5 h-5" />
        </a>

    </div>

</section>