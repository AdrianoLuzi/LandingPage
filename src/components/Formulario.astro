---
// src/components/Formulario.astro
---

<!-- Fondo transparente, z-10 y typo corregido -->
<section id="contacto" class="scroll-mt-20 relative z-10 min-h-screen flex flex-col items-center justify-center py-12">
    
    <div class="w-full max-w-5xl mx-auto px-6 md:px-12 relative z-10">
        
        <div class="text-center mb-12 md:mb-16">
            <h2 class="reveal text-4xl md:text-5xl font-bold text-center mb-3 text-[#6B8CFF] opacity-90 tracking-wide">Hablemos de tu Proyecto</h2>
            <p class="text-xs text-gray-400 px-4">Completá el formulario y nos pondremos en contacto contigo a la brevedad.</p>
        </div>

        <div class="flex flex-col md:flex-row gap-10 md:gap-16 items-center md:items-start justify-center">
            
            <div class="hidden md:flex w-full md:w-1/3 relative justify-center mt-10">
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-[#D4F2B3] opacity-30 blur-[60px] rounded-full z-0"></div>
                <img src="/PinguSergio.svg" alt="Sergio el Pingüino" class="relative z-10 w-48 md:w-56 h-auto drop-shadow-2xl" />
            </div>

            <div class="w-full md:w-1/2 relative z-10 bg-[#1A2332]/30 md:bg-transparent p-6 md:p-0 rounded-xl border border-[#476A8A]/20 md:border-none shadow-xl md:shadow-none">
                <form class="flex flex-col gap-4 md:gap-5">
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="flex flex-col gap-1">
                            <label class="text-[10px] text-[#476A8A] font-semibold tracking-wide uppercase">Nombre</label>
                            <input type="text" placeholder="John" class="w-full bg-transparent border border-[#476A8A]/40 rounded-sm p-3 text-xs text-white focus:outline-none focus:border-[#D4F2B3] transition" />
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="text-[10px] text-[#476A8A] font-semibold tracking-wide uppercase">Apellido</label>
                            <input type="text" placeholder="Doe" class="w-full bg-transparent border border-[#476A8A]/40 rounded-sm p-3 text-xs text-white focus:outline-none focus:border-[#D4F2B3] transition" />
                        </div>
                    </div>

                    <div class="flex flex-col gap-1">
                        <label class="text-[10px] text-[#476A8A] font-semibold tracking-wide uppercase">Teléfono</label>
                        <input type="tel" placeholder="+54 9 264 1234567" class="w-full bg-transparent border border-[#476A8A]/40 rounded-sm p-3 text-xs text-white focus:outline-none focus:border-[#D4F2B3] transition" />
                    </div>

                    <div class="flex flex-col gap-1">
                        <label class="text-[10px] text-[#476A8A] font-semibold tracking-wide uppercase">E-mail</label>
                        <input type="email" placeholder="hola@empresa.com" class="w-full bg-transparent border border-[#476A8A]/40 rounded-sm p-3 text-xs text-white focus:outline-none focus:border-[#D4F2B3] transition" />
                    </div>

                    <div class="flex flex-col gap-1">
                        <label class="text-[10px] text-[#476A8A] font-semibold tracking-wide uppercase">Rubro de la Empresa</label>
                        <input type="text" placeholder="Metalúrgica" class="w-full bg-transparent border border-[#476A8A]/40 rounded-sm p-3 text-xs text-white focus:outline-none focus:border-[#D4F2B3] transition" />
                    </div>

                    <div class="flex flex-col gap-1">
                        <label class="text-[10px] text-[#476A8A] font-semibold tracking-wide uppercase">Descripción del proyecto</label>
                        <textarea rows="4" placeholder="¿Qué querés hacer?" class="w-full bg-transparent border border-[#476A8A]/40 rounded-sm p-3 text-xs text-white focus:outline-none focus:border-[#D4F2B3] transition resize-none"></textarea>
                    </div>

                    <div class="mt-4 flex justify-center md:justify-start w-full">
                        <button type="submit" class="w-full md:w-auto bg-[#D4F2B3] text-[#1A1A1A] font-bold px-12 py-4 rounded-md shadow-[0_0_15px_rgba(212,242,179,0.3)] hover:bg-white hover:scale-105 transition-all text-sm cursor-pointer">
                            Enviar
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</section>