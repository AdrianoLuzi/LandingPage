

<section id="contacto" class="relative bg-[#0A101D] py-24">
    <div class="max-w-5xl mx-auto px-8">
        
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-[#476A8A] mb-3">Hablemos de tu Proyecto</h2>
            <p class="text-xs text-gray-400">Completá el formulario y nos pondremos en contacto contigo a la brevedad.</p>
        </div>

        <div class="flex flex-col md:flex-row gap-16 items-center md:items-start justify-center">
            
            <div class="w-full md:w-1/3 relative flex justify-center mt-10">
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-[#D4F2B3] opacity-30 blur-[60px] rounded-full z-0"></div>
                <img src="/pinguino.png" alt="Sergio el Pingüino" class="relative z-10 w-48 md:w-56 h-auto drop-shadow-2xl" />
            </div>

            <div class="w-full md:w-1/2 relative z-10">
                <form class="flex flex-col gap-5">
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="flex flex-col gap-1">
                            <label class="text-[10px] text-[#476A8A] font-semibold tracking-wide">Nombre</label>
                            <input type="text" placeholder="John" class="bg-transparent border border-[#476A8A]/40 rounded-sm p-2 text-xs text-white focus:outline-none focus:border-[#D4F2B3] transition" />
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="text-[10px] text-[#476A8A] font-semibold tracking-wide">Apellido</label>
                            <input type="text" placeholder="Doe" class="bg-transparent border border-[#476A8A]/40 rounded-sm p-2 text-xs text-white focus:outline-none focus:border-[#D4F2B3] transition" />
                        </div>
                    </div>

                    <div class="flex flex-col gap-1">
                        <label class="text-[10px] text-[#476A8A] font-semibold tracking-wide">Teléfono</label>
                        <input type="tel" placeholder="+54 9 264 1234567" class="bg-transparent border border-[#476A8A]/40 rounded-sm p-2 text-xs text-white focus:outline-none focus:border-[#D4F2B3] transition" />
                    </div>

                    <div class="flex flex-col gap-1">
                        <label class="text-[10px] text-[#476A8A] font-semibold tracking-wide">E-mail</label>
                        <input type="email" placeholder="hola@empresa.com" class="bg-transparent border border-[#476A8A]/40 rounded-sm p-2 text-xs text-white focus:outline-none focus:border-[#D4F2B3] transition" />
                    </div>

                    <div class="flex flex-col gap-1">
                        <label class="text-[10px] text-[#476A8A] font-semibold tracking-wide">Rubro de la Empresa</label>
                        <input type="text" placeholder="Metalúrgica" class="bg-transparent border border-[#476A8A]/40 rounded-sm p-2 text-xs text-white focus:outline-none focus:border-[#D4F2B3] transition" />
                    </div>

                    <div class="flex flex-col gap-1">
                        <label class="text-[10px] text-[#476A8A] font-semibold tracking-wide">Descripción del proyecto</label>
                        <textarea rows="3" placeholder="Qué querés hacer?" class="bg-transparent border border-[#476A8A]/40 rounded-sm p-2 text-xs text-white focus:outline-none focus:border-[#D4F2B3] transition resize-none"></textarea>
                    </div>

                    <div class="mt-4 flex justify-center">
                        <button type="submit" class="bg-[#D4F2B3] text-[#1A1A1A] font-bold px-12 py-3 rounded-md shadow-[0_0_15px_rgba(212,242,179,0.3)] hover:bg-white transition text-xs">
                            Enviar
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</section>