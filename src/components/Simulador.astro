---
// src/pages/Medida.astro
import Layout from '../layouts/Layout.astro';
import '../styles/global.css'; 
---

<Layout title="Cotizar a Medida | Kernel Cynapse">
    <style>
        /* Clase para ocultar la barra de scroll nativa en el carrusel pero permitir el scroll */
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;  /* IE and Edge */
            scrollbar-width: none;  /* Firefox */
        }
    </style>

    <main class="min-h-screen bg-[#0A101D] flex flex-col items-center pt-28 md:pt-32 pb-16 px-4 sm:px-6 font-sans text-[#FFFFFF]">
        
        <!-- Contenedor Principal con min-w-0 para que el carrusel no rompa la estructura -->
        <div class="w-full max-w-[1100px] bg-[#222121] rounded-[2rem] p-5 md:p-8 shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-[#4E6D93]/20 relative overflow-hidden">
            
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[300px] bg-[#4E6D93] opacity-[0.05] blur-[100px] pointer-events-none"></div>

            <div class="flex justify-between items-center mb-8 px-2 md:px-4 relative z-10">
                <div class="flex items-center">
                    <div class="px-3 py-1 border-2 border-[#FFFFFF]/80 rounded-lg text-[#FFFFFF] font-black tracking-widest text-[10px] uppercase shadow-[0_0_10px_rgba(255,255,255,0.1)]">
                        LOGO
                    </div>
                </div>
                
                <h1 class="text-xl md:text-2xl font-bold tracking-wide text-[#FFFFFF]">Configurador de Software</h1>
                
                <div class="flex items-center justify-center cursor-pointer hover:scale-105 transition-transform">
                    <span class="text-[#C8DDA4] font-black text-lg tracking-widest drop-shadow-[0_0_8px_rgba(200,221,164,0.3)]">KC</span>
                </div>
            </div>

            <!-- Layout a 2 Columnas -->
            <div class="flex flex-col lg:flex-row gap-6 lg:gap-8 relative z-10">
                
                <!-- COLUMNA IZQUIERDA: Configurador (Agregado min-w-0 vital para el slider) -->
                <div class="flex-1 space-y-8 min-w-0">
                    
                    <!-- PASO 1: Nombre del Proyecto -->
                    <div>
                        <div class="flex items-center gap-3 mb-4">
                            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-[#4E6D93]/20 text-[#C8DDA4] text-sm font-bold border border-[#4E6D93]/30">1</span>
                            <h2 class="text-lg font-bold text-[#FFFFFF]">Tu Proyecto</h2>
                        </div>
                        <div class="flex gap-3 items-center origin-left">
                            <input type="text" id="input-nombre" placeholder="Ej: Sistema de Gestión..." class="flex-1 bg-[#151515] border border-[#4E6D93]/30 rounded-xl px-4 py-3 text-[#FFFFFF] text-sm placeholder-[#FFFFFF]/30 focus:outline-none focus:border-[#C8DDA4] transition-all duration-300 shadow-inner">
                            
                            <button type="button" id="btn-nombre" class="w-12 h-12 shrink-0 flex items-center justify-center bg-[#2a2929] border border-[#4E6D93]/30 rounded-xl hover:bg-[#4E6D93]/20 transition-all duration-300 text-[#C8DDA4] shadow-sm">
                                <svg id="icon-check-nombre" class="w-5 h-5 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                                <svg id="icon-x-nombre" class="w-5 h-5 hidden transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        </div>
                    </div>

                    <!-- PASO 2: Plataforma Base -->
                    <div>
                        <div class="flex items-center gap-3 mb-4">
                            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-[#4E6D93]/20 text-[#C8DDA4] text-sm font-bold border border-[#4E6D93]/30">2</span>
                            <h2 class="text-lg font-bold text-[#FFFFFF]">Plataforma Base</h2>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <label class="relative block cursor-pointer group/opt h-[135px]">
                                <input type="radio" name="plataforma" value="1550" class="peer sr-only" checked>
                                <div class="absolute inset-0 rounded-[1.2rem] bg-[#2a2929] border border-[#4E6D93]/20 p-4 transition-all duration-300 peer-checked:bg-gradient-to-br peer-checked:from-[#5b7a9e] peer-checked:to-[#4E6D93] peer-checked:border-[#C8DDA4]/40 peer-checked:-translate-y-1 group-hover/opt:-translate-y-1">
                                    <svg class="w-6 h-6 text-[#C8DDA4] mb-2 opacity-80" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                                    <h3 class="text-[15px] font-bold text-[#FFFFFF] mb-1">Sistema Web</h3>
                                    <p class="text-[11px] text-[#FFFFFF]/60 peer-checked:text-[#FFFFFF]/90 leading-tight">Acceso desde navegador.</p>
                                </div>
                                <div class="btn-zone absolute bottom-0 right-0 w-[50px] h-[35px] bg-[#222121] rounded-tl-xl p-1 pb-0 pr-0 z-20 group-has-[:checked]/opt:pointer-events-none">
                                    <div class="relative w-full h-full">
                                        <div class="absolute inset-0 bg-[#151515] rounded-tl-[0.8rem] rounded-br-[1.2rem] transition-transform duration-300 group-hover/opt:translate-y-[2px]"></div>
                                        <div class="absolute inset-0 bg-[#2a2929] rounded-tl-[0.8rem] rounded-br-[1.2rem] flex items-center justify-center transition-transform duration-300 group-hover/opt:-translate-y-[2px] group-has-[:checked]/opt:bg-[#C8DDA4] text-[#FFFFFF]/40 group-has-[:checked]/opt:text-[#222121]">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                                        </div>
                                    </div>
                                </div>
                            </label>

                            <label class="relative block cursor-pointer group/opt h-[135px]">
                                <input type="radio" name="plataforma" value="1150" class="peer sr-only">
                                <div class="absolute inset-0 rounded-[1.2rem] bg-[#2a2929] border border-[#4E6D93]/20 p-4 transition-all duration-300 peer-checked:bg-gradient-to-br peer-checked:from-[#5b7a9e] peer-checked:to-[#4E6D93] peer-checked:border-[#C8DDA4]/40 peer-checked:-translate-y-1 group-hover/opt:-translate-y-1">
                                    <svg class="w-6 h-6 text-[#C8DDA4] mb-2 opacity-80" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                                    <h3 class="text-[15px] font-bold text-[#FFFFFF] mb-1">App Móvil</h3>
                                    <p class="text-[11px] text-[#FFFFFF]/60 peer-checked:text-[#FFFFFF]/90 leading-tight">iOS y Android (Clientes).</p>
                                </div>
                                <div class="btn-zone absolute bottom-0 right-0 w-[50px] h-[35px] bg-[#222121] rounded-tl-xl p-1 pb-0 pr-0 z-20 group-has-[:checked]/opt:pointer-events-none">
                                    <div class="relative w-full h-full">
                                        <div class="absolute inset-0 bg-[#151515] rounded-tl-[0.8rem] rounded-br-[1.2rem] transition-transform duration-300 group-hover/opt:translate-y-[2px]"></div>
                                        <div class="absolute inset-0 bg-[#2a2929] rounded-tl-[0.8rem] rounded-br-[1.2rem] flex items-center justify-center transition-transform duration-300 group-hover/opt:-translate-y-[2px] group-has-[:checked]/opt:bg-[#C8DDA4] text-[#FFFFFF]/40 group-has-[:checked]/opt:text-[#222121]">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                                        </div>
                                    </div>
                                </div>
                            </label>

                            <label class="relative block cursor-pointer group/opt h-[135px]">
                                <input type="radio" name="plataforma" value="2800" class="peer sr-only">
                                <div class="absolute inset-0 rounded-[1.2rem] bg-[#2a2929] border border-[#4E6D93]/20 p-4 transition-all duration-300 peer-checked:bg-gradient-to-br peer-checked:from-[#e0f0cd] peer-checked:to-[#C8DDA4] peer-checked:border-[#4E6D93]/40 peer-checked:-translate-y-1 group-hover/opt:-translate-y-1">
                                    <svg class="w-6 h-6 text-[#C8DDA4] mb-2 opacity-80 group-has-[:checked]/opt:text-[#4E6D93]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                                    <h3 class="text-[15px] font-bold text-[#FFFFFF] group-has-[:checked]/opt:text-[#222121] mb-1 transition-colors">Ecosistema</h3>
                                    <p class="text-[11px] text-[#FFFFFF]/60 group-has-[:checked]/opt:text-[#222121]/80 leading-tight transition-colors">Web + App Móvil.</p>
                                </div>
                                <div class="btn-zone absolute bottom-0 right-0 w-[50px] h-[35px] bg-[#222121] rounded-tl-xl p-1 pb-0 pr-0 z-20 group-has-[:checked]/opt:pointer-events-none">
                                    <div class="relative w-full h-full">
                                        <div class="absolute inset-0 bg-[#151515] rounded-tl-[0.8rem] rounded-br-[1.2rem] transition-transform duration-300 group-hover/opt:translate-y-[2px]"></div>
                                        <div class="absolute inset-0 bg-[#2a2929] rounded-tl-[0.8rem] rounded-br-[1.2rem] flex items-center justify-center transition-transform duration-300 group-hover/opt:-translate-y-[2px] group-has-[:checked]/opt:bg-[#4E6D93] text-[#FFFFFF]/40 group-has-[:checked]/opt:text-[#FFFFFF]">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                                        </div>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- PASO 3: CARRUSEL DE MÓDULOS -->
                    <div>
                        <!-- Encabezado y Flechas de control -->
                        <div class="flex justify-between items-center mb-4">
                            <div class="flex items-center gap-3">
                                <span class="flex items-center justify-center w-7 h-7 rounded-full bg-[#4E6D93]/20 text-[#C8DDA4] text-sm font-bold border border-[#4E6D93]/30">3</span>
                                <h2 class="text-lg font-bold text-[#FFFFFF]">Módulos a Desarrollar</h2>
                            </div>
                            
                            <!-- Flechas Carrusel -->
                            <div class="flex gap-2">
                                <button type="button" id="btn-prev" class="w-8 h-8 rounded-lg bg-[#2a2929] border border-[#4E6D93]/30 hover:bg-[#C8DDA4] hover:text-[#222121] text-[#FFFFFF] flex items-center justify-center transition-all duration-300">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path></svg>
                                </button>
                                <button type="button" id="btn-next" class="w-8 h-8 rounded-lg bg-[#2a2929] border border-[#4E6D93]/30 hover:bg-[#C8DDA4] hover:text-[#222121] text-[#FFFFFF] flex items-center justify-center transition-all duration-300">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
                                </button>
                            </div>
                        </div>

                        <!-- Track del Carrusel -->
                        <div id="carousel-track" class="flex gap-3 overflow-x-auto snap-x snap-mandatory hide-scrollbar pb-4 pt-1 px-1 -mx-1">
                            
                            <!-- Todas las 11 opciones pasadas a tarjetas del carrusel -->
                            
                            <!-- 1. Reporte Estadístico -->
                            <label class="relative block cursor-pointer group/mod shrink-0 snap-start w-[220px] h-[105px]">
                                <input type="checkbox" name="modulo_medida" value="11" class="peer sr-only">
                                <!-- Efecto oscurecer: peer-checked:bg-[#0a0a0a] -->
                                <div class="absolute inset-0 rounded-2xl bg-[#2a2929] border border-[#4E6D93]/20 p-3.5 transition-all duration-300 peer-checked:bg-[#0a0a0a] peer-checked:border-[#C8DDA4]/40 peer-checked:-translate-y-1 group-hover/mod:-translate-y-1 flex flex-col justify-center">
                                    <h4 class="text-[13px] font-bold text-[#FFFFFF] peer-checked:text-[#FFFFFF]/60 mb-1 pr-6 leading-tight transition-colors">Reporte Estadístico</h4>
                                    <p class="text-[10px] text-[#FFFFFF]/50 peer-checked:text-[#FFFFFF]/30 leading-tight line-clamp-1 transition-colors">Resumen mensual de métricas.</p>
                                    <span class="text-[#C8DDA4] font-bold text-[11px] mt-1.5 peer-checked:opacity-50">+$11 USD</span>
                                </div>
                                <div class="absolute bottom-0 right-0 w-[35px] h-[30px] bg-[#222121] rounded-tl-xl p-1 pb-0 pr-0 z-20 group-has-[:checked]/mod:pointer-events-none">
                                    <div class="relative w-full h-full">
                                        <div class="absolute inset-0 bg-[#2a2929] rounded-tl-lg rounded-br-xl flex items-center justify-center transition-colors group-has-[:checked]/mod:bg-[#C8DDA4] text-[#FFFFFF]/20 group-has-[:checked]/mod:text-[#222121]">
                                            <span class="text-sm leading-none group-has-[:checked]/mod:hidden">+</span>
                                            <svg class="w-3 h-3 hidden group-has-[:checked]/mod:block" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                                        </div>
                                    </div>
                                </div>
                            </label>

                            <!-- 2. Apartado de fiado -->
                            <label class="relative block cursor-pointer group/mod shrink-0 snap-start w-[220px] h-[105px]">
                                <input type="checkbox" name="modulo_medida" value="13" class="peer sr-only">
                                <div class="absolute inset-0 rounded-2xl bg-[#2a2929] border border-[#4E6D93]/20 p-3.5 transition-all duration-300 peer-checked:bg-[#0a0a0a] peer-checked:border-[#C8DDA4]/40 peer-checked:-translate-y-1 group-hover/mod:-translate-y-1 flex flex-col justify-center">
                                    <h4 class="text-[13px] font-bold text-[#FFFFFF] peer-checked:text-[#FFFFFF]/60 mb-1 pr-6 leading-tight transition-colors">Apartado de Fiado</h4>
                                    <p class="text-[10px] text-[#FFFFFF]/50 peer-checked:text-[#FFFFFF]/30 leading-tight line-clamp-1 transition-colors">Intereses y comprobantes.</p>
                                    <span class="text-[#C8DDA4] font-bold text-[11px] mt-1.5 peer-checked:opacity-50">+$13 USD</span>
                                </div>
                                <div class="absolute bottom-0 right-0 w-[35px] h-[30px] bg-[#222121] rounded-tl-xl p-1 pb-0 pr-0 z-20 group-has-[:checked]/mod:pointer-events-none">
                                    <div class="relative w-full h-full">
                                        <div class="absolute inset-0 bg-[#2a2929] rounded-tl-lg rounded-br-xl flex items-center justify-center transition-colors group-has-[:checked]/mod:bg-[#C8DDA4] text-[#FFFFFF]/20 group-has-[:checked]/mod:text-[#222121]">
                                            <span class="text-sm leading-none group-has-[:checked]/mod:hidden">+</span>
                                            <svg class="w-3 h-3 hidden group-has-[:checked]/mod:block" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                                        </div>
                                    </div>
                                </div>
                            </label>

                            <!-- 3. Ventas por vendedor -->
                            <label class="relative block cursor-pointer group/mod shrink-0 snap-start w-[220px] h-[105px]">
                                <input type="checkbox" name="modulo_medida" value="10" class="peer sr-only">
                                <div class="absolute inset-0 rounded-2xl bg-[#2a2929] border border-[#4E6D93]/20 p-3.5 transition-all duration-300 peer-checked:bg-[#0a0a0a] peer-checked:border-[#C8DDA4]/40 peer-checked:-translate-y-1 group-hover/mod:-translate-y-1 flex flex-col justify-center">
                                    <h4 class="text-[13px] font-bold text-[#FFFFFF] peer-checked:text-[#FFFFFF]/60 mb-1 pr-6 leading-tight transition-colors">Ventas por Vendedor</h4>
                                    <p class="text-[10px] text-[#FFFFFF]/50 peer-checked:text-[#FFFFFF]/30 leading-tight line-clamp-1 transition-colors">Control de ventas individual.</p>
                                    <span class="text-[#C8DDA4] font-bold text-[11px] mt-1.5 peer-checked:opacity-50">+$10 USD</span>
                                </div>
                                <div class="absolute bottom-0 right-0 w-[35px] h-[30px] bg-[#222121] rounded-tl-xl p-1 pb-0 pr-0 z-20 group-has-[:checked]/mod:pointer-events-none">
                                    <div class="relative w-full h-full">
                                        <div class="absolute inset-0 bg-[#2a2929] rounded-tl-lg rounded-br-xl flex items-center justify-center transition-colors group-has-[:checked]/mod:bg-[#C8DDA4] text-[#FFFFFF]/20 group-has-[:checked]/mod:text-[#222121]">
                                            <span class="text-sm leading-none group-has-[:checked]/mod:hidden">+</span>
                                            <svg class="w-3 h-3 hidden group-has-[:checked]/mod:block" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                                        </div>
                                    </div>
                                </div>
                            </label>

                            <!-- 4. Cálculo de Salarios -->
                            <label class="relative block cursor-pointer group/mod shrink-0 snap-start w-[220px] h-[105px]">
                                <input type="checkbox" name="modulo_medida" value="14" class="peer sr-only">
                                <div class="absolute inset-0 rounded-2xl bg-[#2a2929] border border-[#4E6D93]/20 p-3.5 transition-all duration-300 peer-checked:bg-[#0a0a0a] peer-checked:border-[#C8DDA4]/40 peer-checked:-translate-y-1 group-hover/mod:-translate-y-1 flex flex-col justify-center">
                                    <h4 class="text-[13px] font-bold text-[#FFFFFF] peer-checked:text-[#FFFFFF]/60 mb-1 pr-6 leading-tight transition-colors">Cálculo de Salarios</h4>
                                    <p class="text-[10px] text-[#FFFFFF]/50 peer-checked:text-[#FFFFFF]/30 leading-tight line-clamp-1 transition-colors">Por comisión (hasta 5 emp).</p>
                                    <span class="text-[#C8DDA4] font-bold text-[11px] mt-1.5 peer-checked:opacity-50">+$14 USD</span>
                                </div>
                                <div class="absolute bottom-0 right-0 w-[35px] h-[30px] bg-[#222121] rounded-tl-xl p-1 pb-0 pr-0 z-20 group-has-[:checked]/mod:pointer-events-none">
                                    <div class="relative w-full h-full">
                                        <div class="absolute inset-0 bg-[#2a2929] rounded-tl-lg rounded-br-xl flex items-center justify-center transition-colors group-has-[:checked]/mod:bg-[#C8DDA4] text-[#FFFFFF]/20 group-has-[:checked]/mod:text-[#222121]">
                                            <span class="text-sm leading-none group-has-[:checked]/mod:hidden">+</span>
                                            <svg class="w-3 h-3 hidden group-has-[:checked]/mod:block" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                                        </div>
                                    </div>
                                </div>
                            </label>

                            <!-- 5. Análisis Preventivo -->
                            <label class="relative block cursor-pointer group/mod shrink-0 snap-start w-[220px] h-[105px]">
                                <input type="checkbox" name="modulo_medida" value="20" class="peer sr-only">
                                <div class="absolute inset-0 rounded-2xl bg-[#2a2929] border border-[#4E6D93]/20 p-3.5 transition-all duration-300 peer-checked:bg-[#0a0a0a] peer-checked:border-[#C8DDA4]/40 peer-checked:-translate-y-1 group-hover/mod:-translate-y-1 flex flex-col justify-center">
                                    <h4 class="text-[13px] font-bold text-[#FFFFFF] peer-checked:text-[#FFFFFF]/60 mb-1 pr-6 leading-tight transition-colors">Análisis Preventivo</h4>
                                    <p class="text-[10px] text-[#FFFFFF]/50 peer-checked:text-[#FFFFFF]/30 leading-tight line-clamp-1 transition-colors">Proyecciones y alertas.</p>
                                    <span class="text-[#C8DDA4] font-bold text-[11px] mt-1.5 peer-checked:opacity-50">+$20 USD</span>
                                </div>
                                <div class="absolute bottom-0 right-0 w-[35px] h-[30px] bg-[#222121] rounded-tl-xl p-1 pb-0 pr-0 z-20 group-has-[:checked]/mod:pointer-events-none">
                                    <div class="relative w-full h-full">
                                        <div class="absolute inset-0 bg-[#2a2929] rounded-tl-lg rounded-br-xl flex items-center justify-center transition-colors group-has-[:checked]/mod:bg-[#C8DDA4] text-[#FFFFFF]/20 group-has-[:checked]/mod:text-[#222121]">
                                            <span class="text-sm leading-none group-has-[:checked]/mod:hidden">+</span>
                                            <svg class="w-3 h-3 hidden group-has-[:checked]/mod:block" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                                        </div>
                                    </div>
                                </div>
                            </label>

                            <!-- 6. Generador de Facturas -->
                            <label class="relative block cursor-pointer group/mod shrink-0 snap-start w-[220px] h-[105px]">
                                <input type="checkbox" name="modulo_medida" value="25" class="peer sr-only">
                                <div class="absolute inset-0 rounded-2xl bg-[#2a2929] border border-[#4E6D93]/20 p-3.5 transition-all duration-300 peer-checked:bg-[#0a0a0a] peer-checked:border-[#C8DDA4]/40 peer-checked:-translate-y-1 group-hover/mod:-translate-y-1 flex flex-col justify-center">
                                    <h4 class="text-[13px] font-bold text-[#FFFFFF] peer-checked:text-[#FFFFFF]/60 mb-1 pr-6 leading-tight transition-colors">Generador Facturas</h4>
                                    <p class="text-[10px] text-[#FFFFFF]/50 peer-checked:text-[#FFFFFF]/30 leading-tight line-clamp-1 transition-colors">Emisión de comprobantes.</p>
                                    <span class="text-[#C8DDA4] font-bold text-[11px] mt-1.5 peer-checked:opacity-50">+$25 USD</span>
                                </div>
                                <div class="absolute bottom-0 right-0 w-[35px] h-[30px] bg-[#222121] rounded-tl-xl p-1 pb-0 pr-0 z-20 group-has-[:checked]/mod:pointer-events-none">
                                    <div class="relative w-full h-full">
