<script>
    document.addEventListener("DOMContentLoaded", () => {
        
        // --- 1. Lógica del Nombre del Proyecto ---
        const inputNombre = document.getElementById('input-nombre') as HTMLInputElement;
        const btnNombre = document.getElementById('btn-nombre')!;
        const iconCheckNombre = document.getElementById('icon-check-nombre')!;
        const iconXNombre = document.getElementById('icon-x-nombre')!;
        const resumenNombre = document.getElementById('resumen-nombre')!;

        btnNombre.addEventListener('click', () => {
            if (!inputNombre.readOnly) {
                if(inputNombre.value.trim() === "") return;
                
                inputNombre.readOnly = true;
                
                inputNombre.classList.remove('bg-[#151515]', 'border-[#4E6D93]/30', 'shadow-inner');
                inputNombre.classList.add('bg-[#080808]', 'border-[#151515]', 'text-[#FFFFFF]/50', 'scale-[0.98]');

                resumenNombre.classList.remove('text-[#FFFFFF]/40');
                resumenNombre.classList.add('text-[#C8DDA4]', 'font-bold');
                
                btnNombre.classList.remove('bg-[#2a2929]', 'border-[#4E6D93]/30', 'text-[#C8DDA4]', 'hover:bg-[#4E6D93]/20');
                btnNombre.classList.add('bg-[#111111]', 'border-transparent', 'text-[#FFFFFF]/40');
                
                iconCheckNombre.classList.add('hidden', 'scale-50');
                iconXNombre.classList.remove('hidden');
                setTimeout(() => iconXNombre.classList.remove('scale-50'), 50);

            } else {
                inputNombre.readOnly = false;
                
                inputNombre.classList.remove('bg-[#080808]', 'border-[#151515]', 'text-[#FFFFFF]/50', 'scale-[0.98]');
                inputNombre.classList.add('bg-[#151515]', 'border-[#4E6D93]/30', 'shadow-inner');

                resumenNombre.classList.remove('text-[#C8DDA4]', 'font-bold');
                resumenNombre.classList.add('text-[#FFFFFF]/40');
                
                btnNombre.classList.remove('bg-[#111111]', 'border-transparent', 'text-[#FFFFFF]/40');
                btnNombre.classList.add('bg-[#2a2929]', 'border-[#4E6D93]/30', 'text-[#C8DDA4]', 'hover:bg-[#4E6D93]/20');

                iconXNombre.classList.add('hidden', 'scale-50');
                iconCheckNombre.classList.remove('hidden');
                setTimeout(() => iconCheckNombre.classList.remove('scale-50'), 50);
                
                inputNombre.focus();
            }
        });

        inputNombre.addEventListener('input', (e) => {
            const valor = (e.target as HTMLInputElement).value;
            resumenNombre.textContent = valor ? `"${valor}"` : 'Tu proyecto...';
        });

        // --- 2. Lógica del Carrusel de Módulos ---
        const track = document.getElementById('carousel-track') as HTMLDivElement;
        const btnPrev = document.getElementById('btn-prev');
        const btnNext = document.getElementById('btn-next');

        if(track && btnPrev && btnNext) {
            // Calcula cuánto scroll hacer (Ancho de la tarjeta 220px + Gap 12px = 232px)
            const getScrollAmount = () => {
                const card = track.querySelector('label');
                return card ? card.offsetWidth + 12 : 232; 
            };

            btnNext.addEventListener('click', () => {
                track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
            });

            btnPrev.addEventListener('click', () => {
                track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
            });
        }


        // --- 3. Lógica de Calculadora en Vivo ---
        const plataformas = document.querySelectorAll<HTMLInputElement>('input[name="plataforma"]');
        const modulos = document.querySelectorAll<HTMLInputElement>('input[name="modulo_medida"]');
        const urgencias = document.querySelectorAll<HTMLInputElement>('input[name="urgencia"]');
        
        const textoBase = document.getElementById('resumen-base')!;
        const textoModulos = document.getElementById('resumen-modulos')!;
        const textoUrgencia = document.getElementById('resumen-urgencia')!;
        const textoTotal = document.getElementById('precio-total')!;

        const formatearPlata = (numero: number) => {
            const formateado = new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD',
                maximumFractionDigits: 0
            }).format(numero);
            return `${formateado} USD`;
        };

        const calcularTotal = () => {
            let precioBase = 0;
            let precioModulos = 0;
            let multiplicadorUrgencia = 0;

            const plataformaElegida = document.querySelector<HTMLInputElement>('input[name="plataforma"]:checked');
            if (plataformaElegida) precioBase = parseInt(plataformaElegida.value);

            modulos.forEach(mod => {
                if (mod.checked) precioModulos += parseInt(mod.value);
            });

            const urgenciaElegida = document.querySelector<HTMLInputElement>('input[name="urgencia"]:checked');
            if (urgenciaElegida) multiplicadorUrgencia = parseFloat(urgenciaElegida.value);

            const subtotal = precioBase + precioModulos;
            const costoUrgencia = subtotal * multiplicadorUrgencia;
            const totalFinal = subtotal + costoUrgencia;

            textoBase.textContent = formatearPlata(precioBase);
            textoModulos.textContent = formatearPlata(precioModulos);
            textoUrgencia.textContent = formatearPlata(costoUrgencia);
            textoTotal.textContent = formatearPlata(totalFinal);
        };

        plataformas.forEach(plat => plat.addEventListener('change', calcularTotal));
        urgencias.forEach(urg => urg.addEventListener('change', calcularTotal));

        // Magia del carrusel: Calcular + Avanzar solo
        modulos.forEach(mod => {
            mod.addEventListener('change', (e) => {
                calcularTotal();
                
                // Si el usuario lo "marcó" (true), esperamos medio segundo y scrolleamos
                if ((e.target as HTMLInputElement).checked) {
                    setTimeout(() => {
                        const card = track.querySelector('label');
                        const scrollAmount = card ? card.offsetWidth + 12 : 232;
                        track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                    }, 400); 
                }
            });
        });

        calcularTotal();
    });
</script>