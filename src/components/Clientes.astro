<style>
    /* Animación original hacia la izquierda */
    @keyframes scroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(-30%); }
    }

    /* Animación nueva hacia la derecha */
    @keyframes scroll-reverse {
        0% { transform: translateX(-20%); }
        100% { transform: translateX(0); }
    }

    .animate-scroll {
        animation: scroll 25s linear infinite;
    }

    .animate-scroll-reverse {
        animation: scroll 25s linear infinite reverse;
    }

    /* Al poner el mouse sobre cualquier parte del contenedor, se frenan AMBOS carruseles */
    .carrusel-padre:hover .animate-scroll,
    .carrusel-padre:hover .animate-scroll-reverse {
        animation-play-state: paused;
    }
</style>