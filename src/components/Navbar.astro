---
// src/components/Navbar.astro
// Aquí podemos escribir lógica de servidor si en el futuro la necesitamos.
// Por ahora, solo maquetación pura y rápida.
---

<nav class="flex justify-between items-center py-6 px-8 max-w-7xl mx-auto w-full">
    <div class="flex items-center gap-3">
        <div class="w-8 h-8 bg-kernel-blue rounded-sm flex items-center justify-center text-white font-bold text-xs">
            KC
        </div>
        <span class="font-bold text-xl text-kernel-blue tracking-wide">Kernel Cynapse</span>
    </div>

    <ul class="hidden md:flex gap-8 text-sm font-semibold text-kernel-blue">
        <li><a href="#soluciones" class="hover:text-kernel-blue transition duration-300">Soluciones</a></li>
        <li><a href="#tecnologias" class="hover:text-kernel-blue transition duration-300">Tecnologías</a></li>
        <li><a href="#nosotros" class="hover:text-kernel-blue transition duration-300">Nosotros</a></li>
    </ul>

    <button class="hidden md:block border bg-kernel-green border-kernel-dark text-kernel-dark font-semibold px-6 py-2 rounded-md hover:bg-kernel-blue hover:text-white transition duration-300">
        Contacto
    </button>

    <button class="md:hidden text-kernel-blue focus:outline-none">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
    </button>
</nav>