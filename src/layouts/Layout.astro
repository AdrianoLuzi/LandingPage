---
// src/layouts/Layout.astro

// Definimos las "Props" (propiedades) que este layout va a recibir.
// En este caso, queremos poder cambiar el título de la pestaña del navegador para cada página.
import Navbar from '../components/Navbar.astro';
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Kernel Cynapse - Ingeniería de software para desafíos complejos." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Encode+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
		
		<title>{title}</title>
	</head>
	
	<body class="bg-kernel-bgblue text-kernel-dark antialiased min-h-screen flex flex-col">
		<Navbar />
		<main class="grow">
			<slot />
		</main>

		</body>
</html>


